# Database Configuration
DB_USER=unifind
DB_PASSWORD=unifind_password
DB_NAME=unifind_db

# JWT Configuration
JWT_SECRET=unifind_dntu_secret_key_2026

# Google Auth (OAuth 2.0 Web Client ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Môi trường chạy
GIN_MODE=release

# ==============================================================
# CẤU HÌNH AI GEMINI MIỄN PHÍ (GOOGLE AI STUDIO - CÚ DNTU)
# API key bảo mật trên server/backend, tuyệt đối không đặt tiền tố VITE_
# Nhận API Key miễn phí tại: https://aistudio.google.com/app/apikey
# ==============================================================
CHATBOT_AI_PROVIDER=gemini
CHATBOT_API_KEY=
CHATBOT_MODEL=gemini-1.5-flash
