PORT=8080
DB_DRIVER=sqlite
DATABASE_URL=unifind.db
JWT_SECRET=super-secret-jwt-key-dntu-2026

# ==============================================================
# CẤU HÌNH AI CHATBOT (CÚ DNTU ASSISTANT)
# ==============================================================
# Chọn nhà cung cấp AI: gemini (Google) | openai
CHATBOT_AI_PROVIDER=gemini

# Dán API Key của bạn vào đây (lấy miễn phí tại https://aistudio.google.com/app/apikey)
CHATBOT_API_KEY=

# Tên mô hình AI muốn dùng (khuyên dùng: gemini-2.5-flash, gemini-flash-latest hoặc gpt-4o-mini)
CHATBOT_MODEL=gemini-2.5-flash
